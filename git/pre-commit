#!/bin/sh

# save and change IFS
OLDIFS=$IFS
IFS=$'\n'
UV_CACHE_DIR="${UV_CACHE_DIR:-.uv-cache}"
export UV_CACHE_DIR

# Get staged notebooks, excluding deleted files.
file_list=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.ipynb$')

for file in $file_list
do
  uv run jupyter nbconvert --ClearOutputPreprocessor.enabled=True --inplace "$file"
  if [ $? -ne 0 ]; then
    echo "Jupyter convert failed on staged file '$file'."
    exit 1 # exit with failure status
  fi
  git add "$file"
  if [ $? -ne 0 ]; then
    echo "Could not stage cleaned notebook '$file'."
    exit 1
  fi
done

# restore it
IFS=$OLDIFS
